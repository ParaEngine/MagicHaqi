name = "magic-haqi-growth-api"
main = "src/index.js"
compatibility_date = "2026-08-13"

[[d1_databases]]
binding = "DB"
database_name = "magic-haqi-growth"
database_id = "replace-with-cloudflare-d1-database-id"

[vars]
KEEPWORK_PROFILE_URL = "https://api.keepwork.com/core/v0/users/profile"
KEEPWORK_API_BASE = "https://api.keepwork.com/core/v0"
ALLOWED_ORIGINS = "https://magic-haqi-growth.pages.dev"